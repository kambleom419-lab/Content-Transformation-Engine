# Copy this file to .env and fill in real values. NEVER commit .env.
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-flash-latest

# Concurrency - cap on parallel fan-out branches (one provider request each)
MAX_CONCURRENT_BRANCHES=3

# API layer
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.1.36:3000
ARTEFACTS_DIR=artefacts
USE_STUB=0

# LLM providers - the chain is tried in order and rotated per call
# options: groq | openrouter | gemini | ollama | stub
LLM_PROVIDER=groq
LLM_FALLBACK_CHAIN=groq,openrouter,gemini
LLM_COOLDOWN_S=60

# Latency controls.
#   LLM_TIMEOUT_S  bound a single request; on timeout the next provider is tried.
#   LLM_MAX_TOKENS cap a reply. Latency ~ output_tokens / throughput, so this is
#                  the lever against a model that rambles. 0 = provider default
#                  (leave 0 if a truncated JSON would break a schema).
#   UNDERSTAND_MAX_CHARS_PER_BATCH  bigger batches = fewer, longer calls. A large
#                  PDF costs one call per batch, processed one after another.
LLM_TIMEOUT_S=240
LLM_MAX_TOKENS=0
UNDERSTAND_MAX_CHARS_PER_BATCH=9000

# Groq: text + JSON + Whisper audio
GROQ_API_KEY=your_groq_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo

# OpenRouter: text + vision backup (shared free pool, throttles often)
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_VISION_MODEL=google/gemma-4-26b-a4b-it:free

# Ollama: fully offline option (no key). Start ollama, then add it to the chain.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# Observability - LangSmith tracing is OPT-IN and OFF by default.
# Turning it on exports prompts, model outputs and graph state to a third party.
# For a controlled environment leave it off and use GET /usage instead.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=content-engine
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
